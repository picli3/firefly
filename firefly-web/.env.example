# Copie a .env y genere valores distintos: openssl rand -hex 24
POSTGRES_PASSWORD=
MQTT_PASSWORD=
PUBLIC_ORIGIN=https://localhost:8443
SITE_ADDRESS=localhost
HTTPS_PORT=8443
WEB_BIND=127.0.0.1
# Nombre/IP que debe figurar en el certificado del broker
MQTT_HOST=localhost
# Dirección anunciada a los gateways (nunca el nombre interno "mosquitto")
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=8883
GATEWAY_NTP_SERVERS=pool.ntp.org
MQTT_PORT=8883
MQTT_BIND=127.0.0.1
# Solo para alta inicial (elimine ADMIN_PASSWORD después de crear la cuenta)
ADMIN_EMAIL=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
# Solo simulación opcional; registre primero el gateway en la web
SIM_GATEWAY=sim-gateway
SIM_PASSWORD=
