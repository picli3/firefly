CONFIG_IDF_TARGET="esp32c6"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ZB_ENABLED=y
CONFIG_ZB_COORDINATOR=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_AUTO_TEST_FIRST_DELAY_MINUTES=1440
CONFIG_AUTO_TEST_INTERVAL_MINUTES=1440
CONFIG_AUTO_TEST_GROUP_SIZE=10
CONFIG_AUTO_TEST_DURATION_SECONDS=30
CONFIG_AUTO_TEST_GUARD_SECONDS=15
CONFIG_AUTO_TEST_LEAD_SECONDS=10
