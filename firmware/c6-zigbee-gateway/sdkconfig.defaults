CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ZB_ENABLED=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_AUTO_TEST_ENABLED is not set
CONFIG_AUTO_TEST_FIRST_DELAY_MINUTES=1
CONFIG_AUTO_TEST_INTERVAL_MINUTES=60
CONFIG_AUTO_TEST_GROUP_SIZE=10
CONFIG_AUTO_TEST_DURATION_SECONDS=300
CONFIG_AUTO_TEST_GUARD_SECONDS=15
CONFIG_AUTO_TEST_LEAD_SECONDS=10
