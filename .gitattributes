*.pdf filter=lfs diff=lfs merge=lfs -text
*.FCStd filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.PNG filter=lfs diff=lfs merge=lfs -text
*.JPG filter=lfs diff=lfs merge=lfs -text
*.JPEG filter=lfs diff=lfs merge=lfs -text
# La web se despliega con `git archive`, que copia los punteros LFS en lugar del
# archivo real: sus imágenes se guardan como archivos normales.
firefly-web/**/*.png !filter !diff !merge
firefly-web/**/*.jpg !filter !diff !merge
firefly-web/**/*.jpeg !filter !diff !merge
firefly-web/**/*.PNG !filter !diff !merge
firefly-web/**/*.JPG !filter !diff !merge
firefly-web/**/*.JPEG !filter !diff !merge
